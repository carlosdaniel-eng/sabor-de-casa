# Copie este arquivo para .env e coloque a connection string do Supabase.
# Use a do "Session pooler" (Connect > Session pooler), porque o endereço direto do Supabase é só IPv6.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
DB_SSL=true
PORT=3001
# Endereço do frontend publicado (usado no CORS). Em desenvolvimento pode deixar *
FRONTEND_URL=*
